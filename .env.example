# CivicLens configuration. Copy to `.env` (never commit `.env`).
# Every variable is optional: CivicLens works without any of them.
# Values prefixed with EXPO_PUBLIC_ are inlined into the app bundle at build
# time, so never put a secret in one.

# Map style (MapLibre style JSON URL). Default: OpenFreeMap "dark" (no key).
EXPO_PUBLIC_MAP_STYLE_URL=

# Optional remote inference server (Mode B), e.g. http://192.168.1.20:8787
# Only used when the on-device model is unavailable AND the user enabled
# "Cloud image analysis" in Settings AND Local-only mode is off.
EXPO_PUBLIC_REMOTE_INFERENCE_URL=

# Contact string sent in the User-Agent to OpenStreetMap services (Nominatim
# and Overpass usage policies ask for one), e.g. an email or project URL.
EXPO_PUBLIC_OSM_CONTACT=

# Socrata app token (optional). Raises rate limits for NYC / SF / Chicago 311
# open-data lookups. This is a public, non-secret identifier.
EXPO_PUBLIC_SOCRATA_APP_TOKEN=
